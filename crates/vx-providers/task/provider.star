load("@vx//stdlib:rez.star", "rez_bundle_source")

load("@vx//stdlib:system_install.star", "cross_platform_install")
# provider.star - Task (go-task) provider
#
# task: A task runner / simpler Make alternative written in Go
# Releases: https://github.com/go-task/task/releases
# Asset format: task_{os}_{arch}.{ext}
# Tag format:   v{version}
#
# Uses github_go_provider — Go-style os/arch naming.

load("@vx//stdlib:provider.star",
     "github_go_provider", "runtime_def", "github_permissions")

# ---------------------------------------------------------------------------
# Provider metadata
# ---------------------------------------------------------------------------
name        = "task"
description = "Task - A task runner / simpler Make alternative written in Go"
homepage    = "https://taskfile.dev"
repository  = "https://github.com/go-task/task"
license     = "MIT"
ecosystem   = "devtools"
aliases     = ["go-task", "taskfile"]

# ---------------------------------------------------------------------------
# Runtime definitions
# ---------------------------------------------------------------------------

runtimes = [runtime_def("task", aliases=["go-task"],
                         test_commands = [{"command": "{executable} --version", "name": "version_check",
                                           "expected_output": "^\\d+\\.\\d+\\.\\d+"}])]

# ---------------------------------------------------------------------------
# Permissions
# ---------------------------------------------------------------------------

permissions = github_permissions()

# ---------------------------------------------------------------------------
# Provider functions — all generated by github_go_provider
#
# task asset: "task_{os}_{arch}.{ext}"
# task tag:   "v{version}"
# task has no strip_prefix (executable at archive root)
# ---------------------------------------------------------------------------

_p = github_go_provider(
    "go-task", "task",
    asset      = "task_{os}_{arch}.{ext}",
    executable = "task",
)

fetch_versions   = _p["fetch_versions"]
download_url     = _p["download_url"]
install_layout   = _p["install_layout"]
store_root       = _p["store_root"]
get_execute_path = _p["get_execute_path"]
post_install     = _p["post_install"]
environment      = _p["environment"]
deps             = _p["deps"]

system_install = cross_platform_install(
    windows = "task",
    macos   = "task",
    linux   = "task",
)
# ---------------------------------------------------------------------------
# Rez Next SDK provider descriptor
#
# The descriptor is ready for the provider's immutable Rez bundle release.
# Existing provider installation remains authoritative until that release is
# published, keeping migration independent from bundle publication order.
# ---------------------------------------------------------------------------

_REZ_SDK = rez_bundle_source(
    "vx-org",
    "vx-rez-packages",
    "task",
    published = False,
)
rez_fetch_versions = _REZ_SDK["fetch_versions"]
rez_download_url = _REZ_SDK["download_url"]
rez_install_layout = _REZ_SDK["install_layout"]
rez_bundle = _REZ_SDK["rez_bundle"]